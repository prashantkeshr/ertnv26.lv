{
  "name": "eport-live",
  "private": true,
  "version": "0.1.0",
  "description": "eport — independent global trade and maritime intelligence platform (static, frontend-only).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "predev": "npm run data:build",
    "data:countries": "tsx scripts/build-countries.ts && tsx scripts/build-globe.ts",
    "data:worldbank": "tsx scripts/fetch-worldbank.ts",
    "data:build": "tsx scripts/build-featured.ts && tsx scripts/build-regions.ts && tsx scripts/build-indexes.ts",
    "data:validate": "tsx scripts/validate-data.ts",
    "data:links": "tsx scripts/check-links.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "npm run data:build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "prebuild": "npm run data:build && npm run data:validate",
    "build": "tsc --noEmit && vite build && tsx scripts/generate-static.ts",
    "preview": "vite preview",
    "data:news": "tsx scripts/fetch-news.ts",
    "data:videos": "tsx scripts/check-videos.ts",
    "data:wits": "tsx scripts/fetch-wits.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@hookform/resolvers": "^7.0.6",
    "d3-geo": "^3.1.2",
    "fast-xml-parser": "^5.12.1",
    "flag-icons": "^7.6.0",
    "lucide-react": "^1.73.0",
    "minisearch": "^7.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-router": "^8.5.1",
    "topojson-client": "^3.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0",
    "world-atlas": "^2.0.2",
    "world-countries": "^5.1.0"
  }
}
